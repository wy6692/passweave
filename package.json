{
  "name": "passweave",
  "version": "0.1.0",
  "private": false,
  "description": "Offline-first workbench for designing human-computable, breach-isolated password patterns.",
  "keywords": [
    "password",
    "security",
    "password-generator",
    "credential-stuffing",
    "mnemonic",
    "privacy",
    "offline-first",
    "zero-trust",
    "react",
    "typescript",
    "tailwindcss"
  ],
  "homepage": "https://passweave.gazeo887.workers.dev/",
  "bugs": {
    "url": "https://github.com/wy6692/passweave/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wy6692/passweave.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "cf:login": "wrangler login",
    "cf:deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wrangler": "^4.162.0"
  }
}
